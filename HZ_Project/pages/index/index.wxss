.title-box {
  position: absolute;
  top: 110rpx; /* 可根据实际调整 */
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 24rpx; 
}

.main-title {
  font-size: 40rpx; 
  font-weight: 600; 
  color: #333; 
}

/* 轮播图样式 */
swiper {
  width: 100%; 
  height: 300rpx; /* 可根据实际调整 */
  margin-top: 150rpx; /* 调整轮播图与“主页”的间距 */
  margin-bottom: 24rpx; 
}

swiper image {
  width: 100%;
  height: 100%;
}

.main-container {
  border: 2rpx solid #e0e0e0; 
  border-radius: 16rpx; 
  padding: 24rpx; 
  margin: 16rpx; 
}

.service-list {
  display: flex; 
  flex-wrap: wrap; 
  margin-right: -20rpx; 
}

.service-item {
  width: 48%; 
  box-sizing: border-box; 
  padding: 80rpx;
  background: #394f71; 
  border-radius: 20rpx; 
  color: white; 
  margin-bottom: 20rpx; 
  margin-right: 2%; 
  background-image: url(''); /* 初始为空 */
  background-size: cover;
  background-position: center;
}

.service-name {
  font-size: 28rpx; 
  margin-bottom: 10rpx;
}

.service-desc {
  font-size: 24rpx; 
} 

/* 新增固定按钮容器样式 */
.fixed-button-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-around;
  background-color: rgb(96, 144, 184);
  border-top: 2rpx solid #e0e0e0; /* 分界线粗细和颜色 */
  padding: 35rpx 10rpx;
}

/* 新增固定按钮样式 */
.fixed-button {
  font-size: 28rpx;
  color: #333;
  background-color: transparent;
  border: none;
}